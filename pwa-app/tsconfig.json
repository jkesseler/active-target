{
  "compilerOptions": {
    "types": [],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/mocks/*": [
        "mocks/*"
      ]
    }
  },
  "include": [
    "./*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "@types/**/*.d.ts",
    "./mocks"
  ],
  "exclude": [
    "node_modules"
  ]
}